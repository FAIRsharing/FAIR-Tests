openapi: 3.0.0
info:
  version: "1.0.0"
  title: "FAIR Test - R1.2 - Metadata - Funding information is defined in metadata"
  x-tests_metric: "https://fairsharing.org/7496"
  description: >-
    "This test evaluates whether the metadata includes explicit details regarding the funding associated with the research object. Specifically, it checks for at least one funder entry within the funding data structure. Expected input is the identifier of the record to be tested."
  x-applies_to_principle: "https://fairsharing.org/6313"
  contact:
    x-organization: "FAIRsharing, Oxford University"
    url: "https://fairsharing.org"
    name: "FAIRsharing Support"
    email: "contact@fairsharing.org"
paths:
  "/ft_r1_2_m_funding_defined_in_metadata":
    post:
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/schemas"
        required: true
      responses:
        "200":
          description: >-
            The response is "pass", "fail" or "indeterminate"
servers:
  - url: "https://fair-tests.fairsharing.org/test"
components:
  schemas:
    schemas:
      type: object
      required:
        - resource_identifier
      properties:
        resource_identifier:
          type: string
          description: the GUID being tested
