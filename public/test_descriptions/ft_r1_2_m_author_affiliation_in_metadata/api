openapi: 3.0.0
info:
  version: "1.0.0"
  title: "FAIR Test - R1.2 - Metadata - Author affiliation is defined in metadata"
  x-tests_metric: "https://fairsharing.org/FAIRsharing.342aaa"
  description: >-
    "This test evaluates whether the metadata includes at least one qualified reference to an organisation for a contributor with a creator role. If the record contains a creator with a named organisational affiliation it will pass; otherwise, the test will fail."
  x-applies_to_principle: "https://fairsharing.org/6313"
  contact:
    x-organization: "FAIRsharing, Oxford University"
    url: "https://fairsharing.org"
    name: "FAIRsharing Support"
    email: "contact@fairsharing.org"
paths:
  "/ft_r1_2_m_author_affiliation_in_metadata":
    post:
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/schemas"
        required: true
      responses:
        "200":
          description: >-
            The response is "pass", "fail" or "indeterminate"
servers:
  - url: "https://fair-tests.fairsharing.org/test"
components:
  schemas:
    schemas:
      type: object
      required:
        - resource_identifier
      properties:
        resource_identifier:
          type: string
          description: the GUID being tested
