openapi: 3.0.0
info:
  version: "1.0.0"
  title: "FAIR Test - A1 - Metadata - database open access"
  x-tests_metric: "https://doi.org/10.25504/FAIRsharing.2244b1"
  description: "This test assesses whether the FAIRsharing database record has its Data Access Condition set to Open or Partially Open. Expected input is the FAIRsharing DOI or URL for the FAIRsharing record under evaluation. "
  x-applies_to_principle: "https://doi.org/10.25504/FAIRsharing.7014eb"
  contact:
    x-organization: "FAIRsharing, Oxford University"
    url: "https://fairsharing.org"
    name: "FAIRsharing Support"
    email: "contact@fairsharing.org"
paths:
  "/ft_a1_m_fs_db_open_access":
    post:
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/schemas"
        required: true
      responses:
        "200":
          description:  >-
            The response is "pass", "fail" or "indeterminate"
servers:
  - url: "https://fair-tests.fairsharing.org/test"
components:
  schemas:
    schemas:
      type: object
      required:
        - resource_identifier
      properties:
        resource_identifier:
          type: string
          description: the GUID being tested
