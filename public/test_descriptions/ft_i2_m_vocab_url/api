openapi: 3.0.0
info:
  version: "1.0.0"
  title: "FAIR Test - I2 - Metadata - Vocabulary URL"
  x-tests_metric: "https://fairsharing.org/10.25504/FAIRsharing.0273a2"
  description: >-
    "This test evaluates whether the metadata for the digital object includes an inLanguage attribute containing a well-formed vocabulary URL."
  x-applies_to_principle: "https://fairsharing.org/FAIRsharing.96d4af"
  contact:
    x-organization: "FAIRsharing, Oxford University"
    url: "https://fairsharing.org"
    name: "FAIRsharing Support"
    email: "contact@fairsharing.org"
paths:
  "/ft_i2_m_vocab_url":
    post:
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/schemas"
        required: true
      responses:
        "200":
          description: >-
            The response is "pass", "fail" or "indeterminate"
servers:
  - url: "https://fair-tests.fairsharing.org/test"
components:
  schemas:
    schemas:
      type: object
      required:
        - resource_identifier
      properties:
        resource_identifier:
          type: string
          description: the GUID being tested
