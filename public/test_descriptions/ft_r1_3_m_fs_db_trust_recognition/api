openapi: 3.0.0
info:
  version: "1.0"
  title: "FAIR Test - R1.3 - Metadata - Database demonstrates external trust or recognition"
  x-tests_metric: "https://fairsharing.org/8864"
  description: >-
            "This test evaluates whether the database demonstrates external trust or recognition. In FAIRsharing, this corresponds to the presence of one or more certifications or community badges. This test expects as input the FAIRsharing DOI or URL for the FAIRsharing record under evaluation."
  x-applies_to_principle: "https://doi.org/10.25504/FAIRsharing.87d197"
  contact:
    x-organization: "FAIRsharing, Oxford University"
    url: "https://fairsharing.org"
    name: "FAIRsharing Support"
    email: "contact@fairsharing.org"
paths:
  "/ft_r1_3_m_fs_db_trust_recognition":
    post:
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/schemas"
        required: true
      responses:
        "200":
          description:  >-
            The response is "pass", "fail" or "indeterminate"
servers:
  - url: "https://fair-tests.fairsharing.org/test"
components:
  schemas:
    schemas:
      required:
        - resource_identifier
      properties:
      - resource_identifier:
          type: string
          description: the GUID being tested

